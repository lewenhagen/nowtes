#!/bin/bash
# Toggle the Nowtes window via Hyprland special workspace
APPCLASS="nowtes"
if [ -n "${NOWTES_TERMINAL:-}" ]; then
      TERMINAL="$NOWTES_TERMINAL"
  else
      TERMINAL=""
      for _t in foot ghostty alacritty kitty; do
          if command -v "$_t" &>/dev/null; then
              TERMINAL="$_t"
              break
          fi
      done
      if [ -z "$TERMINAL" ]; then
          notify-send -u critical "Nowtes" "No supported terminal found (foot, ghostty, alacritty, kitty)"
  2>/dev/null
          exit 1
      fi
  fi
APP="$HOME/.local/share/nowtes/nowtes.py"

# foot/wezterm use --app-id; alacritty/kitty/ghostty use --class
case "$TERMINAL" in
    alacritty|kitty|ghostty) CLASS_OPT="--class" ;;
    *)                        CLASS_OPT="--app-id" ;;
esac

_client_exists() {
    hyprctl clients -j 2>/dev/null | python3 -c "
import sys, json
try:
    clients = json.load(sys.stdin)
    sys.exit(0 if any(c.get('class') == '${APPCLASS}' for c in clients) else 1)
except Exception:
    sys.exit(1)
"
}

_is_visible() {
    hyprctl monitors -j 2>/dev/null | python3 -c "
import sys, json
try:
    monitors = json.load(sys.stdin)
    sys.exit(0 if any(m.get('specialWorkspace', {}).get('name') == 'special:${APPCLASS}' for m in monitors) else 1)
except Exception:
    sys.exit(1)
"
}

_on_special_workspace() {
    hyprctl clients -j 2>/dev/null | python3 -c "
import sys, json
try:
    clients = json.load(sys.stdin)
    sys.exit(0 if any(c.get('class') == '${APPCLASS}' and c.get('workspace', {}).get('name') == 'special:${APPCLASS}' for c in clients) else 1)
except Exception:
    sys.exit(1)
"
}

if _client_exists; then
    if ! _on_special_workspace; then
        hyprctl dispatch movetoworkspacesilent "special:${APPCLASS},class:${APPCLASS}"
    fi
    if _is_visible; then
        hyprctl dispatch togglespecialworkspace "$APPCLASS"
    else
        hyprctl --batch "dispatch togglespecialworkspace ${APPCLASS} ; dispatch centerwindow"
    fi
else
    "$TERMINAL" "$CLASS_OPT=$APPCLASS" -e python3 "$APP" &

    # Wait for window to appear (window rule places it in special workspace silently)
    # then show it on the focused monitor and center it there
    for _ in $(seq 30); do
        sleep 0.1
        if _client_exists; then
            hyprctl --batch \
                "dispatch togglespecialworkspace ${APPCLASS} ; dispatch centerwindow"
            break
        fi
    done
fi
