#!/bin/bash
# Toggle the Nowtes window via Hyprland special workspace
APPCLASS="nowtes"
TERMINAL="${NOWTES_TERMINAL:-foot}"
APP="$HOME/.local/share/nowtes/nowtes.py"

_client_exists() {
    hyprctl clients -j 2>/dev/null | python3 -c "
import sys, json
try:
    clients = json.load(sys.stdin)
    sys.exit(0 if any(c.get('class') == '${APPCLASS}' for c in clients) else 1)
except Exception:
    sys.exit(1)
"
}

if _client_exists; then
    hyprctl dispatch togglespecialworkspace "$APPCLASS"
else
    "$TERMINAL" --app-id="$APPCLASS" -e python3 "$APP" &

    # Wait for window to appear (window rule places it in special workspace silently)
    # then show it on the focused monitor and center it there
    for _ in $(seq 30); do
        sleep 0.1
        if _client_exists; then
            hyprctl --batch \
                "dispatch togglespecialworkspace ${APPCLASS} ; dispatch centerwindow"
            break
        fi
    done
fi
