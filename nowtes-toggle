#!/bin/bash
# Toggle the Nowtes window via Hyprland special workspace
APPCLASS="nowtes"
TERMINAL="${NOWTES_TERMINAL:-foot}"
APP="$HOME/.local/share/nowtes/nowtes.py"

if hyprctl clients -j 2>/dev/null | python3 -c "
import sys, json
try:
    clients = json.load(sys.stdin)
    sys.exit(0 if any(c.get('class') == '$APPCLASS' for c in clients) else 1)
except Exception:
    sys.exit(1)
"; then
    hyprctl dispatch togglespecialworkspace "$APPCLASS"
else
    exec "$TERMINAL" --app-id="$APPCLASS" -e python3 "$APP"
fi
